rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /simulations/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /quizAttempts/{attemptId} {
      allow create: if request.auth != null
          && request.resource.data.authId == request.auth.uid;
      allow read: if request.auth != null;
    }

    match /quizzes/{quizId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'teacher'];
    }

    match /users/{docId} {
      function isOwner() {
        return get(/databases/$(database)/documents/users/$(docId))
          .data.authId == request.auth.uid;
      }
      function isAdmin() {
        return request.auth.token.role in ['admin', 'teacher'];
      }
      allow read: if isOwner() || isAdmin();
      allow write: if request.auth.token.role == 'admin';
    }

    match /users/{docId}/activities/{id} {
      function isOwner() {
        return get(/databases/$(database)/documents/users/$(docId))
          .data.authId == request.auth.uid;
      }
      function lectureEndTime() {
        return get(
          /databases/$(database)/documents/classes/$(request.resource.data.classId)
          /lectures/$(request.resource.data.lectureId)
        ).data.endTime;
      }
      function withinClassTime() {
        return request.time <= lectureEndTime();
      }
      allow read: if isOwner();
      allow create: if isOwner()
          && request.resource.data.checkedInAt != null
          && request.resource.data.lectureId == lectureId
          && withinClassTime();
      allow update: if isOwner()
          && request.resource.data.checkedInAt == resource.data.checkedInAt
          && request.resource.data.lectureId == lectureId
          && withinClassTime();
    }

    match /classes/{classId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == 'admin';
    }

    match /classes/{classId}/lectures/{document=**} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role in ['admin', 'teacher'];
    }

    match /classes/{classId}/assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == 'admin';
    }

    match /classes/{classId}/assignments/{assignmentId}/submissions/{studentId} {
      function isStudent() {
        return get(/databases/$(database)/documents/users/$(studentId))
          .data.authId == request.auth.uid;
      }
      allow read: if request.auth != null;
      allow create, update: if isStudent()
          || request.auth.token.role == 'admin';
    }

    match /courseTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == 'admin';
    }
  }
}
