rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /simulations/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    match /users/{docId}/activities/{id} {
      function isOwner() {
        return get(/databases/$(database)/documents/users/$(docId))
          .data.authId == request.auth.uid;
      }    	
    	allow read: if isOwner();
      allow create: if isOwner()
          && request.resource.data.checkedInAt != null
          && request.resource.data.lectureId == lectureId;
      allow update: if isOwner()
        && request.resource.data.checkedInAt == resource.data.checkedInAt
        && request.resource.data.lectureId == lectureId;          
      
    }
  }
}