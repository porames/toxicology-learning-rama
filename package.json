{
	"name": "toxico-learning-svelte",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write 'src/**/*.{svelte,ts,js,css}'",
		"format:check": "prettier --check 'src/**/*.{svelte,ts,js,css}'"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@dnd-kit/svelte": "^0.5.0",
		"@lucide/svelte": "^1.28.0",
		"@tailwindcss/vite": "^4.3.3",
		"dompurify": "^3.4.13",
		"firebase": "^12.17.0",
		"marked": "^18.0.9",
		"moment": "^2.30.1",
		"tailwindcss": "^4.3.3"
	}
}
